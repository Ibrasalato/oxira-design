---
// "Design my plan": the visitor describes the plot and the building, gets an editable concept plan
// (or uploads a plan to be completed) and sends a request to the team.
// Engine: src/scripts/planner/{model,render}.ts, controller: src/scripts/planner/app.ts.
// Requests go to the n8n "Oxira Design" order webhook with package = "plan".
import { N8N, CONTACT, type Lang } from '../i18n/content';
import { pl, PLAN_TYPES, FORMATS, FACADES, BTYPES, STATES } from '../i18n/planner';
import { link } from '../lib/routes';
import { KINDS, defaultBrief, frontSetback } from '../scripts/planner/model';
import Icon from './Icon.astro';
import RegionPicker from './RegionPicker.astro';
import { rg } from '../i18n/region';
import { acc } from '../i18n/account';
import { growth } from '../i18n/growth';
import { plans } from '../i18n/plans';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = pl[lang];
const d = defaultBrief();
d.setback.front = frontSetback(d.land.streetW);
const cfg = { embedCopied: growth[lang].publish.copied, embedLabel: growth[lang].publish.embed, lang, ai: N8N.planAi, order: import.meta.env.PUBLIC_ORDER_ENDPOINT || N8N.order, studio: link(lang, '/studio/'), whatsapp: CONTACT.whatsapp, account: link(lang, '/account/') };
const ac = acc[lang];
const num = (name: string, label: string, value: number, min: number, max: number, step = 1, unit = '') => ({ name, label, value, min, max, step, unit });
const landFields = [num('land.w', p.land.w, d.land.w, 6, 300, 0.5, p.land.m), num('land.d', p.land.d, d.land.d, 6, 300, 0.5, p.land.m)];
const villaNums = [
  num('villa.floors', p.villa.floors, d.villa.floors, 1, 4), num('villa.bedrooms', p.villa.bedrooms, d.villa.bedrooms, 0, 10),
  num('villa.masters', p.villa.masters, d.villa.masters, 0, 4), num('villa.baths', p.villa.baths, d.villa.baths, 0, 4),
];
const villaChecks = ['roof', 'ensuiteAll', 'majlis', 'ladies', 'dining', 'garage', 'maid', 'driver', 'laundry', 'store', 'office', 'guestBed', 'prayer', 'lift'] as const;
const istirahaHide = new Set(['garage', 'villa.floors', 'villa.masters', 'villa.baths', 'roof', 'ensuiteAll', 'maid', 'laundry', 'office', 'guestBed', 'prayer', 'lift', 'majlis']);
const bldNums = [num('bld.floors', p.bld.floors, d.bld.floors, 1, 20), num('bld.perFloor', p.bld.perFloor, d.bld.perFloor, 1, 4), num('bld.beds', p.bld.beds, d.bld.beds, 1, 5)];
const bldChecks = ['majlis', 'maid', 'roof', 'lift'] as const;
---
<section class="page-hero pl-hero">
  <div class="wrap">
    <p class="label">{p.kicker}</p>
    <h1>{p.h1}</h1>
    <p class="lead">{p.lead}</p>
    <ol class="pl-steps">{p.steps.map((s, i) => <li><b>{i + 1}</b>{s}</li>)}</ol>
    <p class="pl-browse"><a class="more" href={link(lang, '/plans/')}>{plans[lang].all} →</a></p>
  </div>
</section>

<section class="pl" id="pl" data-cfg={JSON.stringify(cfg)} data-path="new">
  <div class="wrap">
    <h2 class="pl-h2">{p.path.title}</h2>
    <div class="pl-paths" role="radiogroup">
      <button type="button" class="pl-path" data-go="new" role="radio" aria-checked="true">
        <Icon name="pencil" /><span><b>{p.path.newT}</b><small>{p.path.newD}</small></span>
      </button>
      <button type="button" class="pl-path" data-go="upload" role="radio" aria-checked="false">
        <Icon name="upload" /><span><b>{p.path.upT}</b><small>{p.path.upD}</small></span>
      </button>
    </div>

    <!-- ===================================================== new plan -->
    <div class="pl-grid" data-only="new">
      <form class="pl-panel" id="pl-brief" autocomplete="off" onsubmit="return false">
        <div class="pl-ai">
          <label for="pl-ai-text"><Icon name="spark" /><b>{p.ai.title}</b></label>
          <textarea id="pl-ai-text" rows="3" maxlength="2000" placeholder={p.ai.ph}></textarea>
          <button type="button" class="btn btn-navy pl-wide" id="pl-ai-go"><Icon name="spark" />{p.ai.btn}</button>
          <p class="pl-ai-msg" id="pl-ai-msg" role="status" aria-live="polite" hidden></p>
        </div>
        <fieldset class="pl-sec">
          <legend><b>1</b>{p.land.title}</legend>
          <div class="pl-region">
            <RegionPicker lang={lang} tone="light" />
            <div class="pl-f"><span>{rg[lang].units}</span>
              <div class="pl-seg" role="radiogroup">
                <label><input type="radio" name="units" value="m" checked /><span>{rg[lang].metric}</span></label>
                <label><input type="radio" name="units" value="ft" /><span>{rg[lang].imperial}</span></label>
              </div>
            </div>
          </div>
          <div class="pl-row2">
            {landFields.map((f) => (
              <label class="pl-f"><span>{f.label}</span><span class="pl-unit"><input type="number" name={f.name} value={f.value} min={f.min} max={f.max} step={f.step} inputmode="decimal" dir="ltr" /><i class="pl-u">{f.unit}</i></span></label>
            ))}
          </div>
          <p class="pl-area">{p.land.area}: <b id="pl-area">{d.land.w * d.land.d}</b> <span id="pl-area-u">{p.m2}</span></p>
          <div class="pl-row2">
            <label class="pl-f"><span>{p.land.streets}</span>
              <select name="land.streets">{[1, 2, 3, 4].map((n) => <option value={n} selected={n === d.land.streets}>{n}</option>)}</select>
            </label>
            <label class="pl-f"><span>{p.land.streetW}</span><span class="pl-unit"><input type="number" name="land.streetW" value={d.land.streetW} min="6" max="80" step="1" inputmode="decimal" dir="ltr" /><i class="pl-u">{p.land.m}</i></span></label>
          </div>
          <details class="pl-more">
            <summary>{p.land.setbacks}: <span id="pl-sb-sum" dir="ltr">{d.setback.front} · {d.setback.side} · {d.setback.back}</span></summary>
            <div class="pl-row3">
              <label class="pl-f"><span>{p.land.front}</span><input type="number" name="setback.front" value={d.setback.front} min="0" max="15" step="0.5" dir="ltr" /></label>
              <label class="pl-f"><span>{p.land.side}</span><input type="number" name="setback.side" value={d.setback.side} min="0" max="10" step="0.5" dir="ltr" /></label>
              <label class="pl-f"><span>{p.land.back}</span><input type="number" name="setback.back" value={d.setback.back} min="0" max="10" step="0.5" dir="ltr" /></label>
            </div>
            <p class="pl-small">{p.land.setNote}</p>
          </details>
        </fieldset>

        <fieldset class="pl-sec">
          <legend><b>2</b>{p.type.title}</legend>
          <div class="pl-types">
            {BTYPES.map((t) => (
              <label class="pl-type"><input type="radio" name="type" value={t} checked={t === d.type} /><span><b>{p.type.names[t]}</b><small>{p.type.desc[t]}</small></span></label>
            ))}
          </div>

          <div class="pl-sub" data-for="villa duplex istiraha">
            <h3>{p.villa.title}</h3>
            <div class="pl-row2">
              {villaNums.map((f) => (
                <label class="pl-f" data-hide-ist={istirahaHide.has(f.name) ? '' : undefined}><span>{f.label}</span><span class="pl-step"><button type="button" data-step="-1" aria-label="-">−</button><input type="number" name={f.name} value={f.value} min={f.min} max={f.max} step="1" dir="ltr" /><button type="button" data-step="1" aria-label="+">+</button></span></label>
              ))}
            </div>
            <div class="pl-checks">
              {villaChecks.map((k) => (
                <label class="pl-check" data-hide-ist={istirahaHide.has(k) ? '' : undefined}><input type="checkbox" name={`villa.${k}`} checked={d.villa[k]} /><span>{p.villa[k]}</span></label>
              ))}
            </div>
            <label class="pl-f pl-inline"><span>{p.villa.kitchen}</span>
              <select name="villa.kitchen"><option value="closed">{p.villa.closed}</option><option value="open">{p.villa.open}</option></select>
            </label>
          </div>

          <div class="pl-sub" data-for="building mixed" hidden>
            <h3>{p.bld.title}</h3>
            <div class="pl-row2">
              {bldNums.map((f) => (
                <label class="pl-f"><span>{f.label}</span><span class="pl-step"><button type="button" data-step="-1" aria-label="-">−</button><input type="number" name={f.name} value={f.value} min={f.min} max={f.max} step="1" dir="ltr" /><button type="button" data-step="1" aria-label="+">+</button></span></label>
              ))}
              <label class="pl-f" data-hide-mixed><span>{p.bld.ground}</span>
                <select name="bld.ground"><option value="parking">{p.bld.gParking}</option><option value="shops">{p.bld.gShops}</option><option value="apartments">{p.bld.gApts}</option></select>
              </label>
            </div>
            <div class="pl-checks">
              {bldChecks.map((k) => <label class="pl-check"><input type="checkbox" name={`bld.${k}`} checked={d.bld[k]} /><span>{p.bld[k]}</span></label>)}
            </div>
          </div>
        </fieldset>

        <fieldset class="pl-sec">
          <legend><b>3</b>{p.planTypes.title}</legend>
          <p class="pl-small">{p.planTypes.hint}</p>
          <div class="pl-chips" data-group="planTypes">
            {PLAN_TYPES.map((k) => <label class="pl-chip"><input type="checkbox" name="planTypes" value={k} checked={k === 'arch' || k === 'facade'} /><span>{p.planTypes.names[k]}</span></label>)}
          </div>
          <div class="pl-row2">
            <label class="pl-f"><span>{p.planTypes.facade}</span>
              <select name="facade">{FACADES.map((k) => <option value={k}>{p.planTypes.facades[k]}</option>)}</select>
            </label>
            <div class="pl-f"><span>{p.planTypes.formats}</span>
              <div class="pl-chips pl-chips-s">{FORMATS.map((k) => <label class="pl-chip"><input type="checkbox" name="formats" value={k} checked={k !== 'max'} /><span>{p.planTypes.formatNames[k]}</span></label>)}</div>
            </div>
          </div>
        </fieldset>

        <button type="button" class="btn btn-amber pl-wide" id="pl-gen"><Icon name="pencil" />{p.gen}</button>
        <a class="btn btn-navy pl-wide" href="#pl-order"><Icon name="people" />{p.form.title}</a>
      </form>

      <div class="pl-stage">
        <div class="pl-bar">
          <div class="pl-tabs" id="pl-tabs" role="tablist"></div>
          <div class="pl-tools">
            <button type="button" class="pl-icon" id="pl-undo" title={p.editor.undo} aria-label={p.editor.undo} disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg></button>
            <button type="button" class="pl-link" id="pl-regen" hidden>{p.regen}</button>
          </div>
        </div>
        <div class="pl-canvas-wrap">
          <div class="pl-canvas" id="pl-canvas"><p class="pl-empty">{p.editor.empty}</p></div>
          <div class="pl-roompanel" id="pl-room" hidden>
            <div class="pl-room-h"><b>{p.editor.room}</b><button type="button" class="pl-x" id="pl-room-x" aria-label={p.editor.close}>×</button></div>
            <div class="pl-row2">
              <label class="pl-f"><span>{p.editor.kind}</span><select id="pl-room-kind">{KINDS.map((k) => <option value={k}>{p.kinds[k]}</option>)}</select></label>
              <label class="pl-f"><span>{p.editor.name}</span><input id="pl-room-name" maxlength="40" /></label>
            </div>
            <p class="pl-small">{p.editor.size}: <b id="pl-room-size" dir="ltr"></b></p>
            <div class="pl-room-btns">
              <button type="button" class="btn btn-ghost" id="pl-split">{p.editor.split}</button>
              <button type="button" class="btn btn-ghost" id="pl-swap">{p.editor.swap}</button>
              <button type="button" class="btn btn-ghost pl-danger" id="pl-merge">{p.editor.merge}</button>
            </div>
            <p class="pl-swapnote" id="pl-swapnote" hidden>{p.editor.swapHint} <button type="button" class="pl-link" id="pl-swap-x">{p.editor.cancel}</button></p>
          </div>
        </div>
        <div class="pl-variants" id="pl-variants" hidden>
          <span>{p.variants.title}</span>
          <div class="pl-var-row" id="pl-var-row"></div>
        </div>
        <p class="pl-hint"><Icon name="pencil" />{p.editor.hint}</p>
        <div class="pl-warn" id="pl-warn" hidden></div>

        <dl class="pl-stats" id="pl-stats"></dl>
        <div class="pl-exports">
          <span>{p.editor.exports}</span>
          <button type="button" class="btn btn-ghost" id="pl-dxf"><Icon name="file" />{p.editor.dxf}</button>
          <button type="button" class="btn btn-ghost" id="pl-ifc"><Icon name="building" />{p.editor.ifc}</button>
          <button type="button" class="btn btn-ghost" id="pl-print"><Icon name="file" />{p.editor.print}</button>
          <button type="button" class="btn btn-navy" id="pl-3d"><Icon name="cube" />{p.editor.studio}</button>
        </div>
        <div class="pl-save" id="pl-save">
          <p class="pl-shared" id="pl-shared-note" hidden><Icon name="people" />{ac.save.shared}</p>
          <div class="pl-save-h"><b>{ac.save.title}</b><small>{ac.save.sub}</small></div>
          <a class="btn btn-ghost" id="pl-save-in" href={link(lang, '/account/')}><Icon name="user" />{ac.save.signIn}</a>
          <div class="pl-save-row" id="pl-save-form" hidden>
            <label class="pl-f"><span>{ac.save.name}</span><input id="pl-save-name" maxlength="80" /></label>
            <button type="button" class="btn btn-navy" id="pl-save-go"><Icon name="check" />{ac.save.btn}</button>
          </div>
          <div class="pl-save-row" id="pl-share" hidden>
            <label class="pl-f"><span>{ac.save.share}</span><input id="pl-share-url" readonly dir="ltr" onfocus="this.select()" /></label>
            <button type="button" class="btn btn-ghost" id="pl-share-copy">{ac.save.copy}</button>
          </div>
          <button type="button" class="btn btn-ghost pl-embed" id="pl-embed" hidden title={growth[lang].publish.hint}>{growth[lang].publish.embed}</button>
          <p class="pl-ai-msg" id="pl-save-msg" role="status" aria-live="polite" hidden></p>
          <a class="pl-small" href={link(lang, '/account/')}>{ac.save.mine} →</a>
        </div>
        <p class="pl-small pl-note">{p.editor.note}</p>
      </div>
    </div>

    <!-- ===================================================== upload a plan -->
    <div class="pl-upgrid" data-only="upload">
      <div class="pl-sec">
        <h3 class="pl-h3"><b>1</b>{p.upload.title}</h3>
        <label class="pl-drop" id="pl-drop">
          <input type="file" id="pl-files" multiple accept=".pdf,application/pdf,.dwg,.dxf,.png,.jpg,.jpeg,.webp,.heic,.zip" />
          <Icon name="upload" />
          <b>{p.upload.drop}</b>
          <small>{p.upload.hint}</small>
        </label>
        <ul class="pl-files" id="pl-file-list"></ul>
        <p class="pl-small pl-studio-hint" id="pl-dxf-hint" hidden><Icon name="cube" /><a href="#" id="pl-dxf-open">{p.upload.openStudio}</a></p>
        <div class="pl-import">
          <b><Icon name="spark" />{p.imp.title}</b>
          <p class="pl-small">{p.imp.hint}</p>
          <div class="pl-import-row">
            <label class="pl-f"><span>{p.imp.width}</span><span class="pl-unit"><input type="number" id="pl-imp-w" min="3" max="1000" step="0.1" inputmode="decimal" dir="ltr" /><i class="pl-u">{p.land.m}</i></span></label>
            <button type="button" class="btn btn-navy" id="pl-imp-go"><Icon name="spark" />{p.imp.btn}</button>
          </div>
          <p class="pl-ai-msg" id="pl-imp-msg" role="status" aria-live="polite" hidden></p>
          <p class="pl-small">{p.imp.note}</p>
        </div>
        <h3 class="pl-h3 pl-mt">{p.upload.state}</h3>
        <div class="pl-chips">{STATES.map((k, i) => <label class="pl-chip"><input type="radio" name="state" value={k} checked={i === 1} /><span>{p.upload.states[k]}</span></label>)}</div>
      </div>
      <div class="pl-sec">
        <h3 class="pl-h3"><b>2</b>{p.upload.need}</h3>
        <div class="pl-chips" id="pl-up-types">
          {PLAN_TYPES.map((k) => <label class="pl-chip"><input type="checkbox" name="upTypes" value={k} checked={k === 'arch'} /><span>{p.planTypes.names[k]}</span></label>)}
        </div>
        <div class="pl-row2 pl-mt">
          <label class="pl-f"><span>{p.type.title}</span><select id="pl-up-btype">{BTYPES.map((t) => <option value={t}>{p.type.names[t]}</option>)}</select></label>
          <label class="pl-f"><span>{p.planTypes.facade}</span><select id="pl-up-facade">{FACADES.map((k) => <option value={k}>{p.planTypes.facades[k]}</option>)}</select></label>
          <label class="pl-f"><span>{p.land.area}</span><span class="pl-unit"><input type="number" id="pl-up-area" min="20" max="100000" step="1" inputmode="numeric" dir="ltr" /><i>{p.m2}</i></span></label>
          <div class="pl-f"><span>{p.planTypes.formats}</span>
            <div class="pl-chips pl-chips-s">{FORMATS.map((k) => <label class="pl-chip"><input type="checkbox" name="upFormats" value={k} checked={k !== 'max'} /><span>{p.planTypes.formatNames[k]}</span></label>)}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section-tight bg-paper pl-order" id="pl-order">
  <div class="wrap pl-order-grid">
    <div>
      <h2>{p.form.title}</h2>
      <p class="pl-sub-t">{p.form.sub}</p>
      <p class="pl-attached" id="pl-attached"><Icon name="check" />{p.form.attached}</p>
    </div>
    <form class="pl-form" id="pl-form" novalidate>
      <div class="pl-row2">
        <label class="pl-f"><span>{p.form.name} *</span><input name="name" required autocomplete="name" maxlength="120" /></label>
        <label class="pl-f"><span>{p.form.phone} *</span><input name="phone" required type="tel" autocomplete="tel" dir="ltr" maxlength="40" /></label>
        <label class="pl-f"><span>{p.form.email}</span><input name="email" type="email" autocomplete="email" dir="ltr" maxlength="160" /></label>
        <label class="pl-f"><span>{p.form.city}</span><input name="city" autocomplete="address-level2" maxlength="120" /></label>
      </div>
      <label class="pl-f"><span>{p.form.notes}</span><textarea name="notes" rows="3" maxlength="2000"></textarea></label>
      <div class="pl-f">
        <span>{p.extra.title}</span>
        <label class="pl-drop pl-drop-s"><input type="file" id="pl-extra" multiple accept=".pdf,application/pdf,.png,.jpg,.jpeg,.webp,.heic,.dwg,.dxf,.zip" /><small>{p.extra.hint}</small></label>
        <ul class="pl-files" id="pl-extra-list"></ul>
      </div>
      <input type="text" name="company_website" tabindex="-1" autocomplete="off" class="pl-hp" aria-hidden="true" />
      <button type="submit" class="btn btn-amber pl-wide" id="pl-submit">{p.form.submit}</button>
      <p class="pl-small">{p.form.consent} <a href={link(lang, '/privacy/')}>{p.form.privacy}</a>.</p>
      <div class="pl-msg" id="pl-msg" role="status" aria-live="polite" hidden></div>
    </form>
  </div>
</section>

<div class="pl-print" id="pl-printout" aria-hidden="true"></div>

<script>
  import { startPlanner } from '../scripts/planner/app';
  const root = document.getElementById('pl');
  if (root) startPlanner(root);
</script>

<style is:global>
  .pl-hero { padding-bottom: 1.25rem; }
  .pl-ai { display: grid; gap: .6rem; padding: 1.1rem 1.15rem; border-radius: var(--radius); background: linear-gradient(135deg, #0A253E, #10375A); color: #fff; }
  .pl-ai label { display: flex; align-items: center; gap: .5rem; font-size: 1.02rem; }
  .pl-ai label .ic { width: 1.2rem; height: 1.2rem; color: var(--amber); }
  .pl-ai textarea { font: 500 .98rem/1.55 var(--font); border-radius: 12px; border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.08); color: #fff; padding: .7rem .8rem; resize: vertical; }
  .pl-ai textarea::placeholder { color: var(--muted-on-navy); }
  .pl-ai .btn { background: var(--amber); color: var(--navy); }
  .pl-ai-msg { font-size: .9rem; line-height: 1.6; padding: .55rem .75rem; border-radius: 10px; background: rgba(255,255,255,.1); }
  .pl-import .pl-ai-msg { background: var(--blue-soft); color: var(--navy); margin-top: .6rem; }
  .pl-ai-msg.is-err { background: #FDECEC; color: #9B1C1C; }
  .pl-import { margin-top: 1.2rem; padding: 1rem; border-radius: 14px; border: 1.5px solid var(--amber); background: #FFFBF0; }
  .pl-import > b { display: flex; align-items: center; gap: .45rem; }
  .pl-import > b .ic { width: 1.1rem; height: 1.1rem; color: var(--amber-deep); }
  .pl-import-row { display: grid; grid-template-columns: 1fr auto; gap: .6rem; align-items: end; margin-top: .6rem; }
  .pl-variants { display: grid; gap: .45rem; }
  .pl-variants > span { font-size: .86rem; font-weight: 700; color: var(--muted); }
  .pl-var-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; }
  .pl-var-row button { padding: .3rem; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; cursor: pointer; display: grid; gap: .2rem; font: 600 .78rem var(--font); color: var(--muted); }
  .pl-var-row button[aria-pressed='true'] { border-color: var(--navy); color: var(--navy); box-shadow: 0 0 0 2px rgba(10,37,62,.1); }
  .pl-var-row svg { width: 100%; height: 4.8rem; display: block; }
  .pl-browse { margin-top: 1rem; }
  .pl-steps { list-style: none; padding: 0; margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; color: var(--muted); }
  .pl-steps li { display: flex; align-items: center; gap: .55rem; }
  .pl-steps b, .pl-sec legend b, .pl-h3 b { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 50%; background: var(--blue-soft); color: var(--blue); font-size: .9rem; flex: none; }
