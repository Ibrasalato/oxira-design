---
import { t, CONTACT, type Lang } from '../i18n/content';
import { legal } from '../i18n/legal';
import { link } from '../lib/routes';
interface Props { lang: Lang }
const lang = Astro.props.lang;
const p = t[lang].privacy;
const L = legal[lang];
---
<section class="page-hero"><div class="wrap"><h1>{p.title}</h1><p class="lead">{p.updated}</p></div></section>
<section class="section-tight"><div class="wrap pv">
  {[...p.sections, ...L.privacyMore].map((s) => <article><h2>{s.h}</h2><p>{s.p}</p></article>)}
  <p class="pv-c"><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> · <a href={link(lang, '/terms/')}>{L.nav.terms}</a> · <a href={link(lang, '/refunds/')}>{L.nav.refunds}</a></p>
</div></section>
<style>
  .pv { max-width: 46rem; display: grid; gap: 2rem; }
  .pv h2 { font-size: 1.3rem; margin-bottom: .5rem; }
  .pv p { color: var(--muted); }
  .pv-c a { color: var(--blue); font-weight: 700; }
</style>
