---
// One ready-made plan page: plan drawings for every floor (from the generator, at build time),
// room schedule, facts, and a link that opens the same plan in the editor.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { isRtl, type Lang } from '../i18n/content';
import { pl } from '../i18n/planner';
import { plans, fill } from '../i18n/plans';
import { link } from '../lib/routes';
import { planCatalog, specProject, type PlanSpec } from '../lib/plans';
import { totals, geometry, leaves, type Floor, type Kind } from '../scripts/planner/model';
import { floorSvg } from '../scripts/planner/render';

interface Props { lang: Lang; spec: PlanSpec }
const { lang, spec } = Astro.props;
const P = plans[lang];
const T = pl[lang];
const rtl = isRtl(lang);
const nf = (d: number) => new Intl.NumberFormat(lang === 'ar' ? 'ar-SA-u-nu-latn' : lang, { minimumFractionDigits: d, maximumFractionDigits: d });
const fmt = (n: number, d = 1) => nf(d).format(n);
const names = (k: Kind) => T.kinds[k];
const floorLabel = (f: Floor) => f.key === 'ground' ? T.editor.floor.ground : f.key === 'roof' ? T.editor.floor.roof : f.key === 'typical' ? T.editor.floor.typical.replace('{n}', String(f.repeat)) : T.editor.floor.upper.replace('{n}', String(f.level));

const p = specProject(spec);
const tt = totals(p);
// the roof annex is mentioned in the intro, not counted as a floor
const storeys = p.floors.filter((f) => f.key !== 'roof').reduce((s, f) => s + Math.max(1, f.repeat), 0);
const floorsTxt = storeys === 1 ? P.floors1 : storeys === 2 ? P.floors2 : fill(P.floorsN, { n: storeys });
const units = spec.kind === 'building'
  ? p.floors.reduce((s, f) => s + new Set(leaves(f.root).map((l) => l.unit).filter((u) => u !== 'C' && u !== 'R')).size * Math.max(1, f.repeat), 0)
  : 0;
const bld = spec.kind === 'building';
const kindName = P.kinds[spec.kind].name;
const vars = {
  kind: kindName, kindIntro: P.kinds[spec.kind].intro, w: spec.w, d: spec.d, area: fmt(spec.w * spec.d, 0), beds: spec.beds,
  built: fmt(tt.built, 0), floors: floorsTxt, cov: Math.round(tt.coverage * 100), front: fmt(p.brief.setback.front, 1), side: fmt(p.brief.setback.side, 1), units,
};
const title = fill(bld ? P.titleBld : P.title, vars);
const h1 = fill(bld ? P.h1Bld : P.h1, vars);
const meta = fill(bld ? P.metaBld : P.meta, vars);
const intro = fill(bld ? P.introBld : P.intro, vars);
const ft = (m: number) => Math.round(m / 0.3048);

const floors = p.floors.map((f) => {
  const r = floorSvg(p, f, { names, fmt, m2: T.m2, street: T.street, rtl, edit: false });
  const rooms = geometry(f, f.level === 0).rooms.filter((x) => !['void'].includes(x.leaf.kind)).map((x) => ({ name: x.leaf.name || names(x.leaf.kind), area: x.area }));
  return { label: floorLabel(f), svg: r.svg, rooms, gross: tt.per[p.floors.indexOf(f)].gross };
});

const editHref = `${link(lang, '/plan/')}?plan=${spec.slug}&v=${spec.variant}`;
const all = planCatalog();
const sameSize = all.filter((s) => s.kind === spec.kind && s.w === spec.w && s.d === spec.d && s.slug !== spec.slug);
const area = spec.w * spec.d;
const similar = all.filter((s) => s.kind === spec.kind && s.slug !== spec.slug && !sameSize.includes(s))
  .sort((a, b) => Math.abs(a.w * a.d - area) - Math.abs(b.w * b.d - area) || Math.abs(a.beds - spec.beds) - Math.abs(b.beds - spec.beds)).slice(0, 6);
const cardTitle = (s: PlanSpec) => `${P.kinds[s.kind].name} ${s.w}×${s.d} · ${fill(P.bedsN, { n: s.beds })}`;

const site = Astro.site!;
const abs = (path: string) => new URL(link(lang, path), site).href;
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: P.home, item: abs('/') },
    { '@type': 'ListItem', position: 2, name: P.nav, item: abs('/plans/') },
    { '@type': 'ListItem', position: 3, name: h1, item: abs(`/plans/${spec.slug}/`) },
  ] },
  { '@context': 'https://schema.org', '@type': 'CreativeWork', name: h1, description: meta, inLanguage: lang, isAccessibleForFree: true, creator: { '@type': 'Organization', name: 'Oxira Design', url: 'https://design.oxira.sa/' }, url: abs(`/plans/${spec.slug}/`) },
];
---
<Base lang={lang} path={`/plans/${spec.slug}/`} title={`${title} | Oxira`} description={meta} ld={ld}>
  <section class="page-hero pp-hero">
    <div class="wrap">
      <nav class="pp-crumbs" aria-label="breadcrumb"><a href={link(lang, '/')}>{P.home}</a><span>›</span><a href={link(lang, '/plans/')}>{P.nav}</a></nav>
      <h1>{h1}</h1>
      <p class="lead">{intro}</p>
      <dl class="pp-facts">
        <div><dt>{P.facts.plot}</dt><dd><b dir="ltr">{spec.w}×{spec.d} m</b><small dir="ltr">{fmt(area, 0)} m² · {ft(spec.w)}×{ft(spec.d)} ft</small></dd></div>
        <div><dt>{P.facts.built}</dt><dd><b dir="ltr">{fmt(tt.built, 0)} m²</b><small>{floorsTxt}</small></dd></div>
        <div><dt>{bld ? P.facts.units : P.facts.beds}</dt><dd><b>{bld ? units : spec.beds}</b>{bld && <small>{fill(P.bedsN, { n: spec.beds })}</small>}</dd></div>
        <div><dt>{P.facts.coverage}</dt><dd><b dir="ltr">{Math.round(tt.coverage * 100)}%</b></dd></div>
      </dl>
      <div class="pp-cta">
        <a class="btn btn-amber" href={editHref}><Icon name="pencil" />{P.open}</a>
        <a class="btn btn-ghost" href={`${link(lang, '/plan/')}?plan=${spec.slug}&v=${spec.variant}#pl-order`}><Icon name="people" />{P.order}</a>
      </div>
      <p class="pp-sub">{P.openSub}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap pp-floors">
      {floors.map((f) => (
        <article class="pp-floor">
          <h2>{f.label} <small dir="ltr">{fmt(f.gross, 0)} m²</small></h2>
          <div class="pp-svg" set:html={f.svg} />
          <details>
            <summary>{P.schedule} · {f.rooms.length} {P.facts.rooms}</summary>
            <table><thead><tr><th>{P.room}</th><th>{P.area}</th></tr></thead>
              <tbody>{f.rooms.map((r) => <tr><td>{r.name}</td><td dir="ltr">{fmt(r.area, 1)} m²</td></tr>)}</tbody></table>
          </details>
        </article>
      ))}
      <p class="pp-note">{P.note}</p>
      <a class="btn btn-amber pp-again" href={editHref}><Icon name="pencil" />{P.open}</a>
    </div>
  </section>

  <section class="section-tight bg-paper">
    <div class="wrap">
      {sameSize.length > 0 && (<>
        <h2 class="pp-h2">{P.sameSize}</h2>
        <ul class="pp-cards">{sameSize.map((s) => <li><a href={link(lang, `/plans/${s.slug}/`)}>{cardTitle(s)}</a></li>)}</ul>
      </>)}
      <h2 class="pp-h2">{P.similar}</h2>
      <ul class="pp-cards">{similar.map((s) => <li><a href={link(lang, `/plans/${s.slug}/`)}>{cardTitle(s)}</a></li>)}</ul>
      <p><a class="more" href={link(lang, '/plans/')}>{P.all} →</a></p>
    </div>
  </section>
</Base>

<style>
  .pp-hero { padding-bottom: 1.5rem; }
  .pp-hero h1 { max-width: 26ch; font-size: clamp(1.8rem, 3.6vw, 2.8rem); }
  .pp-crumbs { display: flex; gap: .5rem; font-size: .9rem; margin-bottom: 1rem; color: var(--muted); }
  .pp-crumbs a { color: var(--blue); font-weight: 600; text-decoration: none; }
  .pp-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: .75rem; margin: 1.5rem 0 0; max-width: 52rem; }
  .pp-facts div { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: .8rem 1rem; }
  .pp-facts dt { font-size: .82rem; color: var(--muted); font-weight: 600; }
  .pp-facts dd { margin: .2rem 0 0; display: grid; }
  .pp-facts b { font-size: 1.3rem; }
  .pp-facts small { color: var(--muted); font-size: .8rem; }
  .pp-cta { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.5rem; }
  .pp-sub { color: var(--muted); font-size: .9rem; margin-top: .6rem; }
  .pp-floors { display: grid; gap: 1.5rem; }
  .pp-floor { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem; }
  .pp-floor h2 { font-size: 1.2rem; display: flex; gap: .6rem; align-items: baseline; margin-bottom: .6rem; }
  .pp-floor h2 small { font-size: .85rem; color: var(--muted); font-weight: 600; }
  .pp-svg :global(svg) { width: 100%; height: auto; max-height: 78vh; display: block; }
  .pp-floor details { margin-top: .8rem; }
  .pp-floor summary { cursor: pointer; font-weight: 700; color: var(--navy); }
  .pp-floor table { width: 100%; border-collapse: collapse; margin-top: .5rem; font-size: .92rem; }
  .pp-floor th, .pp-floor td { text-align: start; padding: .4rem .5rem; border-bottom: 1px solid var(--line); }
  .pp-floor td:last-child, .pp-floor th:last-child { text-align: end; white-space: nowrap; }
  .pp-note { color: var(--muted); font-size: .88rem; max-width: 52rem; }
  .pp-again { justify-self: start; }
  .pp-h2 { font-size: 1.25rem; margin: 0 0 .8rem; }
  .pp-cards { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: .5rem; }
  .pp-cards a { display: block; padding: .7rem .9rem; border-radius: 12px; background: #fff; border: 1px solid var(--line); color: var(--navy); font-weight: 600; text-decoration: none; font-size: .95rem; }
  .pp-cards a:hover { border-color: var(--blue); }
</style>
