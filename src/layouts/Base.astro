---
// Same type pairing as oxira.sa: Arabic in Cairo, Latin and Cyrillic in IBM Plex Sans (self-hosted).
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-700.css';
import '@fontsource/ibm-plex-sans/cyrillic-400.css';
import '@fontsource/ibm-plex-sans/cyrillic-500.css';
import '@fontsource/ibm-plex-sans/cyrillic-700.css';
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/noto-sans-devanagari/devanagari-400.css';
import '@fontsource/noto-sans-devanagari/devanagari-700.css';
import '../styles/global.css';
import { t, languages, CONTACT, type Lang } from '../i18n/content';
import { legal } from '../i18n/legal';
import { link, asset } from '../lib/routes';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Chat from '../components/Chat.astro';

// langs: the languages this page exists in (default: all). Only those get hreflang alternates and picker links.
// ld: extra JSON-LD objects for this page.
interface Props { lang: Lang; path: string; title?: string; description?: string; app?: boolean; noindex?: boolean; langs?: Lang[]; ld?: object[] }
const { lang, path, title, description, app = false, noindex = false, langs, ld: extraLd = [] } = Astro.props;
const altLangs = langs ? languages.filter((l) => langs.includes(l.code)) : languages;
const c = t[lang];
const site = Astro.site!;
const pageTitle = title || c.title;
const desc = description || c.description;
const canonical = new URL(link(lang, path), site).href;
const locale = languages.find((l) => l.code === lang)!.locale;
const ogImage = new URL(asset(`og-${lang}.png`), site).href;
const gaId = import.meta.env.PUBLIC_GA_ID || '';
const lg = legal[lang];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Oxira Design',
  serviceType: 'AutoCAD to 3D interior design',
  url: new URL(link('ar', '/'), site).href,
  description: c.description,
  areaServed: [{ '@type': 'Country', name: 'Saudi Arabia' }, 'Worldwide'],
  provider: { '@type': 'Organization', name: 'Oxira', alternateName: 'أوكسيرا', url: CONTACT.main, logo: new URL(asset('favicon.svg'), site).href, email: CONTACT.email, telephone: CONTACT.phoneHref.replace('tel:', ''), address: { '@type': 'PostalAddress', streetAddress: '426 Al Sulaymaniyah, Al Urubah Rd.', addressLocality: 'Riyadh', addressCountry: 'SA' } },
};
---
<!doctype html>
<html lang={lang} dir={c.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {altLangs.map((l) => <link rel="alternate" hreflang={l.code} href={new URL(link(l.code, path), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(link('ar', path), site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Oxira Design" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0A253E" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('sitemap.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {extraLd.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    {gaId && <script is:inline define:vars={{ gaId }}>
      // Analytics: loads straight away, except for visitors in Europe (by time zone), who are asked first.
      (function () {
        var K = 'ox-consent', c = null, tz = '';
        try { c = localStorage.getItem(K); } catch (e) {}
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
        var eu = (/^Europe\//.test(tz) && !/^Europe\/(Moscow|Istanbul|Minsk|Kirov|Volgograd|Saratov|Ulyanovsk|Astrakhan|Samara|Simferopol|Kaliningrad)$/.test(tz)) || /^Atlantic\/(Canary|Madeira|Azores|Reykjavik|Faroe)$/.test(tz);
        function load() {
          var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId; document.head.appendChild(s);
          window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date()); gtag('config', gaId, { anonymize_ip: true });
        }
        if (!eu || c === 'yes') { load(); return; }
        if (c === 'no') return;
        window.__oxConsent = function (v) { try { localStorage.setItem(K, v); } catch (e) {} if (v === 'yes') load(); var b = document.getElementById('ox-consent'); if (b) b.remove(); };
        document.addEventListener('DOMContentLoaded', function () { var b = document.getElementById('ox-consent'); if (b) b.hidden = false; });
      })();
    </script>}
  </head>
  <body class={app ? 'is-app' : ''}>
    <a class="skip" href="#main">{lang === 'ar' ? 'انتقل إلى المحتوى' : lang === 'ur' ? 'مواد پر جائیں' : 'Skip to content'}</a>
    <Header lang={lang} path={path} app={app} langs={langs} />
    <main id="main">
      <slot />
    </main>
    {!app && <Footer lang={lang} path={path} langs={langs} />}
    <Chat lang={lang} />
    {gaId && (
      <div class="ox-consent" id="ox-consent" role="dialog" aria-live="polite" hidden>
        <p>{lg.consent.text} <a href={link(lang, '/privacy/')}>{lg.consent.more}</a></p>
        <div><button type="button" class="btn btn-ghost" onclick="__oxConsent('no')">{lg.consent.decline}</button><button type="button" class="btn btn-navy" onclick="__oxConsent('yes')">{lg.consent.accept}</button></div>
      </div>
    )}
  </body>
</html>
