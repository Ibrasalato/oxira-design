---
import Base from '../../../layouts/Base.astro';
import Studio from '../../../components/Studio.astro';
import { languages, type Lang } from '../../../i18n/content';
import { st } from '../../../i18n/studio';
export function getStaticPaths() {
  return languages.filter((l) => l.code !== 'ar').map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} path="/studio/" title={`${st[lang].title} | DXF → 3D`} description={st[lang].meta} app><Studio lang={lang} /></Base>
