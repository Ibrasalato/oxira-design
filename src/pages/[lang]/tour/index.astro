---
import Base from '../../../layouts/Base.astro';
import Tour from '../../../components/Tour.astro';
import { languages, type Lang } from '../../../i18n/content';
import { tr } from '../../../i18n/tour';
export function getStaticPaths() {
  return languages.filter((l) => l.code !== 'ar').map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} path="/tour/" title={`${tr[lang].title} | Oxira Design`} description={tr[lang].meta} noindex><Tour lang={lang} /></Base>
