---
import Base from '../../../layouts/Base.astro';
import Privacy from '../../../components/Privacy.astro';
import { languages, t, type Lang } from '../../../i18n/content';
export function getStaticPaths() {
  return languages.filter((l) => l.code !== 'ar').map((l) => ({ params: { lang: l.code } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} path="/privacy/" title={`${t[lang].privacy.title} | Oxira Design`} description={t[lang].privacy.sections.slice(0, 2).map((x) => x.p).join(' ').slice(0, 155)}><Privacy lang={lang} /></Base>
